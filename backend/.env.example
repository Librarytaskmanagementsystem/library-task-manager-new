PORT=5000
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/library_task_manager
# For Atlas, replace the line above with the exact URI from Atlas > Connect > Drivers.
# Optional workaround if Node.js SRV lookup is refused by your network:
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
GEMINI_API_KEY=replace_with_your_own_key
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGIN=http://localhost:5173
